# ===== 大模型（阿里云百炼 DashScope，OpenAI 兼容模式）=====
# 在 https://bailian.console.aliyun.com/ 创建 API Key，格式形如 sk-xxxxxxxx
model_api_key=
model_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可用模型：qwen-max / qwen-plus（qwen-max-0919 等旧版本已对多数账号停用）
model_name=qwen-max
model_temperature=0.01
model_top_p=0.01

# ===== 向量库 / 文档库 =====
milvus_uri=http://localhost:19530
milvus_db_name=tool_db
mongo_host=127.0.0.1
mongo_db=tools
mongo_port=27112

# ===== 检索与截断参数 =====
topK=10
api_result_max_length=30000
api_result_max_threshold=0.1

# ===== 工具调用鉴权（被编排的外部服务用它做 X-API-Key 校验）=====
# 用本地 mock_server.py 演示时可随便填一串非空字符串
sim_api_key=local-demo-key

# ===== JWT =====
SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256

# ===== 本地模式：1 = 强制走本机 Milvus(19530) + 本机 Mongo(27112) =====
local_mode=1

# ===== 本地向量模型目录（仅当改用本地 embedding 时才需要）=====
model_path=model
